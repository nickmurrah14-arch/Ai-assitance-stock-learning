# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
# Default claude-opus-5; claude-sonnet-5 costs less per message
ANTHROPIC_MODEL=claude-opus-5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The public https URL this app is reachable at (e.g. https://leads.yourdomain.com)
PUBLIC_BASE_URL=
VALIDATE_TWILIO_SIGNATURE=1

CLIENTS_FILE=clients.json
DB_PATH=leads.db
