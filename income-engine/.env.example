# Copy to .env and fill in. Never commit .env.

# Google Cloud console -> enable "Places API (New)" -> create API key
GOOGLE_PLACES_API_KEY=
# Optional, raises PageSpeed Insights quota
PAGESPEED_API_KEY=

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Default is claude-opus-5 (~1.5 cents/email); claude-sonnet-5 is ~0.6 cents/email
ANTHROPIC_MODEL=claude-opus-5

# Who the emails come from. A real postal address (a PO box or virtual mailbox works) is required by CAN-SPAM.
SENDER_NAME=
SENDER_COMPANY=
SENDER_EMAIL=
SENDER_POSTAL_ADDRESS=
SENDER_CITY=Deltona, FL
BOOKING_LINK=

# What you're selling, in 1-3 plain sentences
OFFER=

# SMTP for the secondary sending domain. Zoho Mail Lite ($1/mo): smtp.zoho.com. Google Workspace: smtp.gmail.com + app password
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Warm-up: start at 5/day, add ~5 every 2-3 days, cap at 30 per inbox
DAILY_SEND_LIMIT=5
SECONDS_BETWEEN_SENDS=90
